/*
  # Strict security headers for all routes
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://formspree.io; worker-src 'self' blob:; frame-ancestors 'none';
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# Immutable caching for hashed static assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# No caching for HTML pages (always fresh)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Service worker must not be cached
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
